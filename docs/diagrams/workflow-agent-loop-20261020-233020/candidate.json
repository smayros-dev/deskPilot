  "cards": [
    {
      "dot": "amber",
      "title": "Behaviour-changing switches",
      "items": [
        "Settings: specialists, grounding check, self-check, enabled tools and approval tools",
        "Experiments page: a running A/B experiment picks model and prompt per conversation",
        "MODERATION_ENABLED adds a model-based input check; RATE_LIMIT_* sets the buckets"
      ]
    },
    {
      "dot": "rose",
      "title": "Stops and pauses",
      "items": [
        "Gated tool calls pause the whole step; a rejection returns an error result the model must explain",
        "Grounding and ticket checks send the model back at most once per turn",
        "Self-check and routing model calls do not use up the step budget"
      ]
    }
  ]
